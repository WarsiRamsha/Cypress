{
  "name": "cypressautomation",
  "version": "1.0.0",
  "description": "This is Cypress Automation",
  "main": "index.js",
  "scripts": {
    "cypress:install": "npx cypress install",
    "merge-reports": "npx mochawesome-merge cypress/reports/*.json > cypress/reports/report.json",
    "generate-report": "npx marge cypress/reports/report.json --reportDir cypress/reports --inline",
    "posttest": "npm run merge-reports && npm run generate-report",
    "cypress:run": "npx cypress run"
  },
  "author": "Ramsha Warsi",
  "license": "ISC",
  "devDependencies": {
    "@percy/cli": "^1.31.0",
    "@percy/cypress": "^3.1.6",
    "cypress": "^13.17.0",
    "cypress-mochawesome-reporter": "^3.8.4",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.4.1",
    "mochawesome-report-generator": "^6.2.0",
    "prettier": "^3.6.2"
  }
}
